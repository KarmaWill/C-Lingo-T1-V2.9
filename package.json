{
  "name": "nsk-horizon-local-agent",
  "version": "1.0.0",
  "description": "NSK Horizon OS Local Agent Application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "dev:2000": "VITE_SCREEN_SIZE=2000x1200 vite --port 3001",
    "dev:960": "VITE_SCREEN_SIZE=960x540 vite --port 3001",
    "dev:1920": "VITE_SCREEN_SIZE=1920x1125 vite --port 3001",
    "dev:1920-1080": "VITE_SCREEN_SIZE=1920x1080 vite --port 3002",
    "dev:all": "concurrently --names \"1024,960,1920\" --prefix-colors \"blue,green,yellow\" \"npm run dev\" \"npm run dev:960\" \"npm run dev:1920\"",
    "dev:all-4": "concurrently --names \"1024,960,1920,1920-1080\" --prefix-colors \"blue,green,yellow,cyan\" \"npm run dev\" \"npm run dev:960\" \"npm run dev:1920\" \"npm run dev:1920-1080\"",
    "open:all": "bash open-all-resolutions.sh",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "deploy:lan:start": "./deploy-lan-start.sh",
    "deploy:lan:stop": "./deploy-lan-stop.sh",
    "deploy:lan:status": "./deploy-lan-status.sh",
    "deploy:lan:logs": "./deploy-lan-logs.sh",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "docs:api": "typedoc --options ../typedoc.json",
    "docs:tech-stack": "node ../scripts/extract-tech-stack.js > ../temp/tech-stack.json && node ../scripts/generate-tech-stack-doc.js --input ../temp/tech-stack.json --output ../docs/architecture/tech-stack.md",
    "docs:features": "node ../scripts/extract-features.js > ../temp/features.json",
    "docs:business-plan": "npm run docs:tech-stack && npm run docs:features && node ../scripts/fill-template.js --template ../docs/business/business-plan-template.md --tech-stack ../temp/tech-stack.json --features ../temp/features.json --output '../NSK Horizon OS 商业计划书 V2.2.md'",
    "docs:changelog": "node ../scripts/generate-changelog.js --output ../docs/business/changelog.md",
    "docs:all": "npm run docs:api && npm run docs:business-plan && npm run docs:changelog"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.20",
    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.6.2",
    "framer-motion": "^12.38.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^7.3.1"
  }
}
